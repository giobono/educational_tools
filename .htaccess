# ── Application pages route through the flag ──────────────────────────────
# CD dispatch to OD, 23 August, items 2, 4 and 5.
#
# This file is plumbing and does not decide anything. It routes the four
# application pages through app_gate.php, which reads the SAME
# config/apps/<app>/config.js that apps-enabled.php reads and that the D
# instances built. Turning an application on or off remains one edit to one
# config file outside the web root — no rebuild, no copy pass, and nothing
# here changes.
#
# The earlier version of this file denied the three unreleased paths outright.
# That met CD's item 2 but broke the thing CD asked to keep: a static deny
# makes switching an application on a file edit rather than a flag change.
#
# robots.txt stays silent on these paths deliberately. A Disallow stops the
# crawler fetching the page, so it never reads the noindex header, so a URL
# found elsewhere can still be indexed as a bare link with no way to remove
# it. The header is the control, and app_gate.php sets it in both flag states.

<IfModule mod_rewrite.c>
  RewriteEngine On
  # CR3 lives at apps/corres/ (OD's merge brief of 19 Nov 2026 §2.2). The
  # trial's old address answers with a 301 to the same path under it, so a
  # link in Louis's pack still lands. corres_v2 is the earlier app, moved aside.
  RewriteRule ^apps/corres_trial/?(.*)$ /apps/corres/$1 [R=301,L]
  # One spelling per app page (OD brief to D1Dev of 25 Nov 2026, Part B.2.4):
  # /apps/x/index.html answers 301 to /apps/x/, as /apps/x does below. Sign-in
  # no longer returns to the page's own address (it returns to
  # /auth/callback.html), so this cannot bring back the 21 Nov loop.
  RewriteRule ^apps/(gioianie|sanzognie|corres|corres_v2|pluralitie)/index\.html$ /apps/$1/ [R=301,L]
  RewriteRule ^apps/(gioianie|sanzognie|corres|corres_v2|pluralitie)/([A-Za-z0-9_.-]+\.html)$ app_gate.php?app=$1&page=$2 [L,QSA]
  # A directory under /apps/ asked for without its trailing slash answers 301 to the
  # slash form, before the app gate below can serve it at the slashless address, where
  # the page's relative files would not load (OD brief of 21 Nov 2026).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^apps/([a-z0-9_]+)$ /apps/$1/ [R=301,L]
  RewriteRule ^apps/(gioianie|sanzognie|corres|corres_v2|pluralitie)/?$ app_gate.php?app=$1&page=index.html [L,QSA]
</IfModule>

# ── Nothing but the site is served ────────────────────────────────────────
# OD brief to D2Dev, 19 November 2026, §4.1.
#
# The git root of this repository IS the served root, so a committed file is
# a live URL. Measured before this rule was written, on beta:
#   /tests/test_signin_boundary.py   HTTP 200, 3,123 bytes
#   /.gitignore                      HTTP 200
# The test names the identity supplier and the closed route, which is why the
# brief puts this rule before the next pull rather than after it.
#
# `.git/`, `.htaccess` and `.DS_Store` were already refused by the host. That
# is the host's default, not ours, and a default can change with a host or a
# plan — so they are named here too. A rule we can read is worth more than a
# refusal we are relying on without knowing its source.
#
# This rule is interim. The repository and site structure are reviewed after
# promotion (brief §4.1).
#
# `.well-known/` is exempt deliberately: it begins with a dot, and denying it
# would break ACME certificate renewal. Its challenge filenames carry no
# leading dot, so the FilesMatch fallback below does not reach them either.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # The test suite is not part of the site.
  RewriteRule ^tests(/|$) - [F,L]

  # The repository's own metadata.
  RewriteRule ^\.git(/|$) - [F,L]

  # Dotfiles and dot-directories at any depth, except .well-known.
  RewriteCond %{REQUEST_URI} !^/\.well-known(/|$)
  RewriteRule (^|/)\.[^/]+ - [F,L]
</IfModule>

# Belt and braces: should mod_rewrite ever be absent, dotfiles stay refused.
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
