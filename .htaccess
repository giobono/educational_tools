# ── Unreleased applications ───────────────────────────────────────────────
# CD dispatch to OD, 23 August, items 2, 4 and 5.
#
# The existing gate is client-side: edu_common.js's enforceAppActive() replaces
# the document with document.open/write/close AFTER the server has already sent
# it in full. Anything that reads HTML without executing it receives the whole
# page. These rules withhold it at the server instead, which is what CD asked
# for; the flag stays and nothing is deleted.
#
# Both directives apply in BOTH flag states, deliberately: turning an
# application on for beta must not silently turn indexing on with it.
#
# robots.txt stays silent on these paths on purpose. A Disallow stops the
# crawler fetching the page, so it never reads the noindex header, so a URL
# discovered elsewhere can still be indexed as a bare link with no way to
# remove it. The header is the control.

<IfModule mod_headers.c>
  <FilesMatch "\.(html|php)$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# 403 rather than 404: the paths exist and are switched off, and a 404 would be
# a false statement about the estate. Serves no document either way.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^apps/(gioianie|sanzognie|pluralitie)(/.*)?$ - [F,L]
</IfModule>
