# ── Application pages route through the flag ──────────────────────────────
# CD dispatch to OD, 23 August, items 2, 4 and 5.
#
# This file is plumbing and does not decide anything. It routes the four
# application pages through app_gate.php, which reads the SAME
# config/apps/<app>/config.js that apps-enabled.php reads and that the D
# instances built. Turning an application on or off remains one edit to one
# config file outside the web root — no rebuild, no copy pass, and nothing
# here changes.
#
# The earlier version of this file denied the three unreleased paths outright.
# That met CD's item 2 but broke the thing CD asked to keep: a static deny
# makes switching an application on a file edit rather than a flag change.
#
# robots.txt stays silent on these paths deliberately. A Disallow stops the
# crawler fetching the page, so it never reads the noindex header, so a URL
# found elsewhere can still be indexed as a bare link with no way to remove
# it. The header is the control, and app_gate.php sets it in both flag states.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^apps/(gioianie|sanzognie|corres|pluralitie)/([A-Za-z0-9_.-]+\.html)$ app_gate.php?app=$1&page=$2 [L,QSA]
  RewriteRule ^apps/(gioianie|sanzognie|corres|pluralitie)/?$ app_gate.php?app=$1&page=index.html [L,QSA]
</IfModule>
